# Supabase Public Environment Variables (Browser-Safe)
# Obtain these values from your Supabase Dashboard -> Project Settings -> API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-actual-publishable-key

# Cloudflare Turnstile Public Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Supabase Public Environment Variables (Browser-Safe)
# Obtain these values from your Supabase Dashboard -> Project Settings -> API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-actual-publishable-key

# Enable only after the public SELECT grants/policies are applied to the target project.
NEXT_PUBLIC_SUPABASE_PUBLIC_CONTENT_ENABLED=false

# Cloudflare Turnstile Public Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Supabase Edge Function secrets (server-only; never prefix with NEXT_PUBLIC_)
# Set these with `supabase secrets set` for the target project. Do not commit real values.
ADMIN_AUTH_EMAIL=admin-account@example.com
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Oriens Academy <notifications@example.com>

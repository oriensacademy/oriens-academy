# Browser-safe Supabase project URL. Use http://127.0.0.1:54321 for local Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key (legacy anon keys are also supported by the client).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy browser key used only when the publishable key is unavailable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enables database-backed public pricing/testimonial reads after target policies are installed.
NEXT_PUBLIC_SUPABASE_PUBLIC_CONTENT_ENABLED=false

# Browser-visible Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server/tooling-only Supabase service-role key. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Functions receive this project URL from the platform.
SUPABASE_URL=

# Google Mail credentials stored as Supabase Edge Function secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM_NAME=Oriens Academy
MAIL_FROM_EMAIL=notifications@oriens-academy.com

# Cloudflare Turnstile secret stored as a Supabase Edge Function secret.
TURNSTILE_SECRET_KEY=

# Payment provider selection is intentionally unset until official bank
# Virtual POS documentation and sandbox credentials are available.
BANK_PAYMENT_PROVIDER=

# HTTPS public origin used for hosted payment return URLs by Edge Functions.
PUBLIC_SITE_URL=https://oriens-academy.com

# Administrator identity allowed to use password recovery.
ADMIN_AUTH_EMAIL=

# Optional Edge Function development markers used by local verification.
DENO_ENV=
ENVIRONMENT=

# Optional OpenAlex API key used by university ingestion tooling.
OPENALEX_API_KEY=

# Optional search-regression base URL.
SEARCH_BASE_URL=

# Optional browser-QA Chrome DevTools endpoint and Chrome executable path.
CDP_ENDPOINT=
CHROME_PATH=

# Explicit local-only administrator values consumed by setup and QA scripts.
ORIENS_LOCAL_ADMIN_EMAIL=
ORIENS_LOCAL_ADMIN_PASSWORD=

# Controlled non-production inbox and optional synthetic phone used by submission QA.
QA_TEST_EMAIL=
QA_TEST_PHONE=
